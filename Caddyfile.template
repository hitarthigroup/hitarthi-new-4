{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	handle /health {
		respond 200
	}

	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		-Server
	}

	# 📲 WhatsApp (Meta) webhook → Google Apps Script (HITARTHI Sheet का "WhatsApp Inbox")
	@waverify {
		path /wa-webhook
		method GET
		query hub.verify_token=hitarthi-wa-7a1bf4d3ca1a
	}
	handle @waverify {
		respond "{http.request.uri.query.hub.challenge}" 200
	}
	@wapost {
		path /wa-webhook
		method POST
	}
	handle @wapost {
		reverse_proxy https://script.google.com {
			rewrite /macros/s/AKfycbz_lNguiwN0VTpMo4BEQDJefj2mET8QyPeteS_CqOloLivlgxdcAKl5xzoo0KlswlHOkg/exec?wa=hke27faf9989a66f2a7017
			header_up Host {upstream_hostport}
			@redir status 3xx
			handle_response @redir {
				respond "ok" 200
			}
		}
	}
	handle /wa-webhook {
		respond "forbidden" 403
	}

	# 🔁 Razorpay Subscription webhook → Apps Script (signature + event id URL में, क्योंकि Apps Script header नहीं पढ़ता)
	@rzphook {
		path /rzp-webhook
		method POST
	}
	handle @rzphook {
		reverse_proxy https://script.google.com {
			rewrite /macros/s/AKfycbz_lNguiwN0VTpMo4BEQDJefj2mET8QyPeteS_CqOloLivlgxdcAKl5xzoo0KlswlHOkg/exec?wa=r&rzp=1&sig={http.request.header.X-Razorpay-Signature}&eid={http.request.header.X-Razorpay-Event-Id}
			header_up Host {upstream_hostport}
			@redir2 status 3xx
			handle_response @redir2 {
				respond "ok" 200
			}
		}
	}
	handle /rzp-webhook {
		respond "forbidden" 403
	}


	# नाम में hash वाली files (js/abc123.js, img/abc123.webp) कभी नहीं बदलतीं → 1 साल cache
	@hashed path_regexp hashed ^/(js|img)/[0-9a-f]{10,12}(-\d+)?\.(js|webp|jpg|jpeg|png)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# बाकी images / icons → 7 दिन
	@static {
		path_regexp static \.(webp|jpg|jpeg|png|svg|ico|woff2)$
		not path_regexp ^/(js|img)/[0-9a-f]{10,12}(-\d+)?\.(js|webp|jpg|jpeg|png)$
	}
	header @static Cache-Control "public, max-age=604800"
	# HTML, service worker, manifest → हर बार ताज़ा (ETag से जल्दी जाँच)
	@fresh path_regexp fresh (\.html$|/$|^/sw\.js$|\.webmanifest$)
	header @fresh Cache-Control "no-cache"
	header /manifest.webmanifest Content-Type "application/manifest+json"

	root * {{.StaticFileRoot}}


	encode {
		zstd
		gzip
	}

	# बाकी सब: website की files (WhatsApp webhook ऊपर अलग handle होता है)
	handle {
		try_files {path} {path}.html {path}/index.html{{if .IndexFallback}} /index.html{{end}}
		file_server {
			hide .git
			hide .env*
			hide Caddyfile.template
		}
	}

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}

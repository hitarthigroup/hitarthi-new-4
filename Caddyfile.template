{
	admin off
	persist_config off
	auto_https off
	log {
		format json
	}
	servers {
		trusted_proxies static private_ranges
	}
}

:{$PORT:80} {
	log {
		format json
	}

	respond /health 200

	header {
		X-XSS-Protection "1; mode=block"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https: *; style-src 'self' 'unsafe-inline' https: *; script-src 'self' 'unsafe-inline' https: *; font-src 'self' data: https: *; connect-src 'self' https: *; media-src 'self' https: *; object-src 'none'; frame-src 'self' https: *;"
		-Server
	}

	# नाम में hash वाली files (js/abc123.js, img/abc123.webp) कभी नहीं बदलतीं → 1 साल cache
	@hashed path_regexp hashed ^/(js|img)/[0-9a-f]{10,12}(-\d+)?\.(js|webp|jpg|jpeg|png)$
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	# बाकी images / icons → 7 दिन
	@static {
		path_regexp static \.(webp|jpg|jpeg|png|svg|ico|woff2)$
		not path_regexp ^/(js|img)/[0-9a-f]{10,12}(-\d+)?\.(js|webp|jpg|jpeg|png)$
	}
	header @static Cache-Control "public, max-age=604800"
	# HTML, service worker, manifest → हर बार ताज़ा (ETag से जल्दी जाँच)
	@fresh path_regexp fresh (\.html$|/$|^/sw\.js$|\.webmanifest$)
	header @fresh Cache-Control "no-cache"

	root * {{.StaticFileRoot}}

	file_server {
		hide .git
		hide .env*
		hide Caddyfile.template
	}

	encode {
		zstd
		gzip
	}

	try_files {path} {path}.html {path}/index.html{{if .IndexFallback}} /index.html{{end}}

	handle_errors {
		rewrite * /{err.status_code}.html
		file_server
	}
}
